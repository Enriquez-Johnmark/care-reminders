  "db_name": "PostgreSQL",
  "query": "select distinct on (r.id) r.id as reminder, r.number, d.id as draft, d.source, d.text, d.problems, d.warnings\n             from reminders r join drafts d on d.tenant_id = r.tenant_id and d.reminder_id = r.id\n             where r.tenant_id = $1\n             order by r.id, d.attempt desc",
