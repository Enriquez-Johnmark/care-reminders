{
  "db_name": "PostgreSQL",
  "query": "select f.id, p.name as patient_name, f.kind, f.reason, f.due_by, r.name as rule_name, f.rule_version, f.stop\n             from follow_ups f\n             join patients p on p.tenant_id = f.tenant_id and p.id = f.patient_id\n             join rules r on r.tenant_id = f.tenant_id and r.id = f.rule_id\n             where f.tenant_id = $1\n             order by f.due_by, p.name, f.id",
